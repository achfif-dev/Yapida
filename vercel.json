{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://database-yapida-app.firebaseapp.com/__/auth/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
